# --- AWS Bedrock configuration for sf-agents -------------------------------
# Copy to `.env` and fill in. Nothing outside src/sf_agents/primitives/_llm.py
# reads these; the rest of the framework is provider-agnostic.

# Region that serves your Anthropic Claude inference profile.
AWS_REGION=eu-north-1

# Preferred: a cross-region inference profile ARN (checked FIRST).
# BEDROCK_INFERENCE_PROFILE_ARN=arn:aws:bedrock:eu-north-1:123456789012:inference-profile/eu.anthropic.claude-...

# Fallback: a plain on-demand model id (used only if the ARN is unset).
# BEDROCK_MODEL_ID=eu.anthropic.claude-3-7-sonnet-20250219-v1:0

# Standard AWS credential chain (or use a named profile / SSO / instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: override the governance defaults.
# SF_AGENTS_CONFIDENCE_FLOOR=0.70
# SF_AGENTS_DATA_DIR=Sample Data
# SF_AGENTS_AUDIT_DIR=audit_logs
